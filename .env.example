# huawei2mqtt configuration. Copy to .env and fill in. Never commit .env.

# --- Inverter (Modbus TCP, via SDongle) ---
# Host/IP of the SDongle / inverter (REQUIRED)
HUAWEI_HOST=
# Modbus TCP port (default 502)
HUAWEI_PORT=
# Modbus unit id; with SDongle the inverter is usually 1 (default 1)
HUAWEI_UNIT_ID=
# Override for the device id used in the topic (default: serial number read from the inverter)
HUAWEI_DEVICE_ID=
# Allow the "off" command (inverter shutdown) via MQTT/portal (default false)
HUAWEI_ALLOW_SHUTDOWN=
# Modbus request timeout in seconds (default 5)
MODBUS_TIMEOUT=
# Pause between two Modbus requests in milliseconds (default 200)
MODBUS_REQUEST_DELAY_MS=
# Poll interval for live values in seconds (default 10, minimum 5)
POLL_INTERVAL_LIVE=
# Poll interval for static values in seconds (default 300, minimum 60)
POLL_INTERVAL_STATIC=

# --- MQTT broker (external) ---
# Broker host (REQUIRED)
MQTT_HOST=
# Broker port (default 1883)
MQTT_PORT=
# Broker user name (optional)
MQTT_USERNAME=
# Broker password (optional, secret)
MQTT_PASSWORD=
# MQTT client id (default huawei2mqtt-<DEVICE_ID>)
MQTT_CLIENT_ID=
# Use TLS to the broker (default false)
MQTT_TLS=
# Skip TLS certificate verification (default false, not recommended)
MQTT_TLS_INSECURE=
# Path to a CA file for TLS (optional)
MQTT_CA_FILE=
# MQTT keepalive in seconds (default 60)
MQTT_KEEPALIVE=
# QoS for published values, 0..2 (default 0)
MQTT_QOS=
# Publish values retained (default true)
MQTT_RETAIN=
# Topic prefix; full base topic is <MQTT_BASE_TOPIC>/<DEVICE_ID> (default huawei)
MQTT_BASE_TOPIC=
# Also publish one topic per field (default true)
MQTT_FLAT_TOPICS=

# --- History and awards (stored in DATA_DIR/huawei2mqtt.db) ---
# Days of detailed samples (10 s resolution) to keep, 1..90 (default 7)
HISTORY_DAYS=
# Feed-in tariff per kWh for the money display, 0..5 (default 0.08)
FEED_IN_TARIFF=
# Currency code, 3 upper-case letters (default EUR)
CURRENCY=
# CO2 factor in kg per kWh, 0..2 (default 0.38)
CO2_FACTOR=
# Milestone step in kWh of total yield, 100..100000 (default 1000)
MILESTONE_STEP_KWH=

# --- Portal ---
# Host port mapping for the portal (docker compose only, default 8080)
PORTAL_PORT=
# Portal password; empty = portal is read-only (secret)
PORTAL_PASSWORD=
# Directory for persistent data (default /data, or ./data when /data does not exist)
DATA_DIR=
# Directory with the static portal files (default <repo>/web)
WEB_DIR=

# --- General ---
# Log level: DEBUG, INFO, WARNING, ERROR (default INFO)
LOG_LEVEL=
# Time zone (default Europe/Berlin)
TZ=

# Port the portal listens on INSIDE the process (default 8080; keep 8080 in containers)
PORTAL_LISTEN_PORT=
